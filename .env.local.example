# Firebase Web App config (Project Settings -> General -> Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: only needed for the YouTube playlist import feature (Admin -> Import).
# Uses the free YouTube Data API v3 quota (no billing required for normal usage).
YOUTUBE_API_KEY=

# Comma-separated list of emails that should be treated as admins on first sign-in
# (used by scripts/setAdmin and as a fallback check). Real admin status is stored
# on the user's Firestore document (users/{uid}.role).
NEXT_PUBLIC_SEED_ADMIN_EMAILS=admin@example.com
